{
  "compilerOptions": {
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom", "dom.iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": false,
    "rootDir": ".",
    "outDir": "../site/pkg",
    "declaration": true,
    "types": []
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
